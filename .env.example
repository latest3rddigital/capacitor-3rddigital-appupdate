# 3rdDigital AppUpdate API
APPUPDATE_BASE_URL=https://your-api-url.com
APPUPDATE_API_KEY=YOUR_API_KEY

# AWS S3 Configuration
APPUPDATE_AWS_REGION=wrapped-region-key
APPUPDATE_AWS_ACCESS_KEY_ID=wrapped-access-key-id
APPUPDATE_AWS_SECRET_ACCESS_KEY=wrapped-secret-access-key
APPUPDATE_AWS_BUCKET_NAME=your-bucket-name

# (Optional) Android release signing for `appupdate-apk`.
# If omitted, the script looks for android/keystore.properties or any
# *.jks / *.keystore file inside android/ and prompts for credentials.
# APPUPDATE_KEYSTORE_PATH=android/your-release-key.jks
# APPUPDATE_KEYSTORE_PASSWORD=your-store-password
# APPUPDATE_KEYSTORE_ALIAS=your-key-alias
# APPUPDATE_KEY_PASSWORD=your-key-password
# APPUPDATE_KEYSTORE_PROPERTIES_FILE=android/custom-keystore.properties

# (Optional) `appupdate-apk` prompt-skipping / build overrides.
# APPUPDATE_API_TOKEN=your-api-token          # skips the "Enter API Token" prompt
# APPUPDATE_PROJECT_ID=your-project-id        # skips the "Enter Project ID" prompt
# APPUPDATE_ANDROID_FLAVOR=smcrm              # default Android product flavor
# APPUPDATE_JAVA_HOME=/path/to/jdk-21         # Gradle JDK (Capacitor 7 needs 21+)
# APPUPDATE_APK_DIR=android/app/release         # extra dir scanned for existing release APKs
